# Copy to backend/.env and fill in what you have.
# Everything is optional — the app runs with any single LLM key below.

# ── LLM provider keys ─────────────────────────────────────────────
# Priority order: Google → Cerebras → Groq → DeepSeek → Anthropic.
# Free tiers (Google/Groq/Cerebras) are enough for the full pipeline.
# ANTHROPIC_API_KEY additionally enables web-grounded research via
# Claude's server-side web_search tool (recommended, ~$0.20/run).
GOOGLE_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# ── App ───────────────────────────────────────────────────────────
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# SQLite checkpoints + project index live here (gitignored)
DATA_DIR=data

# ── Optional: Supabase (frontend auth) ────────────────────────────
# Leave empty to run in demo mode (no login). See README.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=
