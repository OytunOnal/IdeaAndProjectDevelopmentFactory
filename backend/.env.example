# â”€â”€ LLM provider keys â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Priority order: Google â†’ Cerebras â†’ Groq â†’ DeepSeek â†’ Anthropic.
# Free tiers (Google/Groq/Cerebras) are enough for the full pipeline.
# ANTHROPIC_API_KEY additionally enables web-grounded research via
# Claude's server-side web_search tool (recommended, ~$0.20/run).
GOOGLE_API_KEY=
CEREBRAS_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=

# â”€â”€ App â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
# SQLite checkpoints + project index live here (gitignored)
DATA_DIR=data

# â”€â”€ Optional: Supabase (frontend auth) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
# Leave empty to run in demo mode (no login). See README.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# -- Local model routing, OPT-IN (see LOCAL_MIGRATION_PLAN.md) ----------
# With Ollama installed and qwen3:8b pulled, uncommenting these runs the
# chat/intent layer on your machine (measured at 90% on the golden-intent
# set vs the frontier chain's 87%, zero dangerous inversions). The frontier
# chain remains the automatic fallback either way. Without Ollama, leave
# these commented - everything runs on the free-tier chain as before.
# LLM_ROLE_PROVIDERS=discussion=ollama,verify=ollama
# LLM_ROLE_THINK=discussion=on
#
# Spec generators on the local quality model (qwen3.6:35b, think-on): judged
# at/near frontier parity on the Phase 2 dev set — see evals/results/generators/
# JUDGE.md. ":quality" pins the quality model for all five generator roles
# (three of them are tier-2 calls that would otherwise hit the fast model,
# which failed the financial-coherence audit). Requires qwen3.6:35b pulled;
# expect ~3-4 min/document on consumer hardware vs seconds on the API chain.
# LLM_ROLE_PROVIDERS=discussion=ollama,verify=ollama,spec=ollama:quality
# LLM_ROLE_THINK=discussion=on,spec=on
#
# Decomposed Devil's Advocate (Phase 3): replaces the monolithic adversarial-
# review call with six local micro-passes (numeric audit with Python verdicts,
# evidence audit, absence scan, cross-doc consistency, scope echo, open
# critique) — held-out-validated at the frontier baseline's recall band with a
# fully local runtime (evals/REPORT.md, Phase 3). Requires both qwen3:8b and
# qwen3.6:35b pulled; expect several minutes per review. The monolithic path
# remains the automatic fallback if the decomposed run fails.
# DA_DECOMPOSED=true

